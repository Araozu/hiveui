---
/*
 * Placeholder logo: a regular hexagon with flat sides left and right and a
 * point at the top and bottom. Replace the geometry when the logo is designed,
 * and keep this orientation so the mark stays consistent with the comb.
 */
interface Props {
	class?: string;
	label?: string;
}

const { class: className = 'size-9', label } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 100 100"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
>
	<polygon points="50,4 89.8,27 89.8,73 50,96 10.2,73 10.2,27" fill="var(--color-propolis)" />
	<polygon points="50,26 70.8,38 70.8,62 50,74 29.2,62 29.2,38" fill="var(--color-honey)" />
</svg>
